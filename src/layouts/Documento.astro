---
interface Props {
  titulo: string;
  lead: string;
  rascunho?: boolean;
}

const { titulo, lead, rascunho = false } = Astro.props;
---

<section class="doc-cabeca">
  <div class="container">
    {
      rascunho && (
        <div class="rascunho" role="note">
          <strong>Rascunho em revisão</strong>
          Este texto ainda está sendo revisado pelo responsável pelo Juntas e pode mudar antes da publicação do app.
        </div>
      )
    }
    <h1>{titulo}</h1>
    <p class="lead">{lead}</p>
  </div>
</section>
<div class="container doc">
  <slot />
</div>
