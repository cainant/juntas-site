---
import '../styles/site.css';

interface Props {
  titulo: string;
  descricao: string;
  /** Caminho público ('' para o início). Sem ele a página sai com noindex e sem tags de compartilhamento. */
  caminho?: string;
  /** href do item de navegação que está aberto. */
  atual?: string;
  /** Cabeçalho só com a marca (telas do enxoval). */
  minimo?: boolean;
  /** Impede que o endereço da página vá no Referer (o link do enxoval fica no fragmento, mas por garantia). */
  semReferrer?: boolean;
}

const { titulo, descricao, caminho, atual, minimo = false, semReferrer = false } = Astro.props;
const SITE = 'https://juntas.app.br/';
const EMAIL = 'ctravizanutto@gmail.com';
const indexavel = caminho !== undefined;

const NAV: [string, string][] = [
  ['/#recursos', 'Recursos'],
  ['/#bia', 'Bia'],
  ['/#enxoval', 'Enxoval'],
  ['/#para-quem', 'Para quem'],
  ['/#perguntas', 'Perguntas'],
  ['/contato/', 'Suporte'],
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#f9f5f1" />
    {semReferrer && <meta name="referrer" content="no-referrer" />}
    {
      indexavel ? (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:locale" content="pt_BR" />
          <meta property="og:site_name" content="Juntas" />
          <meta property="og:title" content={titulo} />
          <meta property="og:description" content={descricao} />
          <meta property="og:url" content={`${SITE}${caminho}`} />
          <meta property="og:image" content={`${SITE}assets/og.jpg`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <link rel="icon" href="/assets/favicon.png" type="image/png" />
    <link rel="icon" href="/assets/icone.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preload" href="/assets/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <div class="container topo-in">
        <a class="marca" href="/"><img src="/assets/icone.svg" alt="" width="36" height="36" />Juntas</a>
        {
          minimo ? (
            <slot name="cabeca" />
          ) : (
            <>
              <nav aria-label="Principal">
                <ul>
                  {NAV.map(([href, rotulo]) => (
                    <li>
                      <a href={href} aria-current={atual === href ? 'page' : undefined}>
                        {rotulo}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
              <a class="btn btn-sm" href="/#baixar">Baixar o app</a>
            </>
          )
        }
      </div>
    </header>

    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    {
      minimo ? (
        <footer class="rodape-min">
          <div class="container">
            <p>
              <a href="/">Juntas</a> · <a href="/privacidade/">Política de privacidade</a> · <a href="/contato/">Suporte</a>
            </p>
          </div>
        </footer>
      ) : (
    <footer class="rodape">
      <div class="container">
        <div class="rodape-in">
          <div>
            <a class="marca" href="/"><img src="/assets/icone.svg" alt="" width="36" height="36" />Juntas</a>
            <p>A gestante, a profissional de saúde que a acompanha e as pessoas de confiança no mesmo cuidado.</p>
          </div>
          <div>
            <h2>O app</h2>
            <ul>
              <li><a href="/#recursos">Recursos</a></li>
              <li><a href="/#bia">Bia</a></li>
              <li><a href="/#enxoval">Enxoval</a></li>
              <li><a href="/#para-quem">Para quem</a></li>
              <li><a href="/#perguntas">Perguntas</a></li>
            </ul>
          </div>
          <div>
            <h2>Ajuda</h2>
            <ul>
              <li><a href="/contato/">Suporte</a></li>
              <li><a href="/privacidade/">Política de privacidade</a></li>
              <li><a href="/termos/">Termos de uso</a></li>
              <li><a href="/excluir-conta/">Excluir conta</a></li>
            </ul>
          </div>
        </div>
        <p class="base">
          Juntas · {EMAIL} · O Juntas não substitui atendimento de saúde. Em emergência, ligue 192 (SAMU).
        </p>
      </div>
    </footer>
      )
    }
  </body>
</html>
